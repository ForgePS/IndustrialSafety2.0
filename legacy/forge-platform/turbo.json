{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:unit": {
      "dependsOn": ["^build"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:rls": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:platform-e2e": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "clean": {
      "cache": false
    },
    "generate": {
      "cache": false
    },
    "infra:synth": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": [
        "FORGE_ENV",
        "FORGE_PRODUCTION_ACCOUNT",
        "FORGE_STAGING_ACCOUNT",
        "FORGE_TESTING_ACCOUNT",
        "FORGE_GOVCLOUD_DEV_ACCOUNT",
        "CDK_DEFAULT_ACCOUNT",
        "CDK_DEFAULT_REGION"
      ]
    }
  }
}
