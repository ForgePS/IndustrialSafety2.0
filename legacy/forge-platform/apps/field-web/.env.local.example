# Field web (local) — copy to .env.local and restart `pnpm --filter @forge/field-web dev`.
# Reuses the Development Industrial Cognito app client until Field has its own client.

NEXT_PUBLIC_APP_ENV=local
# Prefer same-origin + FIELD_API_PROXY_TARGET so the browser avoids api-dev CORS.
NEXT_PUBLIC_API_URL=http://localhost:3005
NEXT_PUBLIC_APP_URL=http://localhost:3005
FIELD_API_PROXY_TARGET=https://api-dev.forgepublicsafety.com

# Or point at a local platform-api (requires Cognito pool env matching Development):
# NEXT_PUBLIC_API_URL=http://localhost:4000
# FIELD_API_PROXY_TARGET=

# Development Identity exports (ForgeIdentity-*).
NEXT_PUBLIC_COGNITO_DOMAIN=forge-development-547817.auth.us-east-1.amazoncognito.com
NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_VYjUFLXG4
NEXT_PUBLIC_COGNITO_CLIENT_ID=3rls9835j4qs3jmchb3uh7ketm

# Optional local bypass (never enable in deployed builds).
# NEXT_PUBLIC_ALLOW_DEV_PRINCIPAL=true
# NEXT_PUBLIC_DEV_PRINCIPAL={"sub":"...","email":"...","tenantId":"..."}
