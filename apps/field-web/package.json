{
  "name": "@forge/field-web",
  "version": "0.1.0",
  "private": true,
  "description": "Forge Safety - Field Version — mobile operational PWA for Forge Industrial Safety",
  "scripts": {
    "dev": "next dev --port 3005",
    "build": "next build",
    "start": "next start --port 3005",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run",
    "test:unit": "vitest run",
    "clean": "rimraf .next out"
  },
  "dependencies": {
    "@bradycorporation/brady-web-sdk": "3.3.0",
    "@forge/contracts": "workspace:*",
    "@forge/photo-markup": "workspace:*",
    "@forge/web-kit": "workspace:*",
    "dexie": "^4.4.6",
    "next": "^15.3.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
