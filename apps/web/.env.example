BASEPATH=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_APP_DOMAIN=

# App Configuration
NEXT_PUBLIC_APP_NAME=Forge Industrial Safety
NEXT_PUBLIC_APP_TITLE=%s | Forge Industrial Safety
NEXT_PUBLIC_APP_DESCRIPTION=Industrial safety, training, compliance, inspections, fleet, emergency management, and reporting.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AUTH
NEXT_PUBLIC_AUTH_PASSWORD=true
NEXT_PUBLIC_AUTH_MAGIC_LINK=false

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Lemon Squeezy
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_WEBHOOK_SIGNATURE=

# Session Secret
SESSION_SECRET=

# Translations
NEXT_PUBLIC_I18N_COOKIE_NAME=lang
