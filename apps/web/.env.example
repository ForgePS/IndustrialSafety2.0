BASEPATH=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_APP_DOMAIN=
# Optional stable domain for printed managed QR codes. Falls back to NEXT_PUBLIC_APP_URL.
QR_BASE_URL=

# App Configuration
NEXT_PUBLIC_APP_NAME=Forge Industrial Safety 2.0
NEXT_PUBLIC_APP_TITLE=%s | Forge Industrial Safety 2.0
NEXT_PUBLIC_APP_DESCRIPTION=Forge Industrial Safety 2.0 - industrial safety, training, compliance, inspections, fleet, emergency management, and reporting.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Forge AI - server only
# Never prefix the API key with NEXT_PUBLIC_.
OPENAI_API_KEY=
FORGE_AI_MODEL=gpt-6-sol
# Strong random secret used by the scheduled AI Watch endpoint.
FORGE_AI_CRON_SECRET=
FORGE_AI_EMBEDDING_MODEL=text-embedding-3-small

# Google OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AUTH
NEXT_PUBLIC_AUTH_PASSWORD=true
NEXT_PUBLIC_AUTH_MAGIC_LINK=false

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Lemon Squeezy
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_WEBHOOK_SIGNATURE=

# Session Secret
SESSION_SECRET=

# Translations
NEXT_PUBLIC_I18N_COOKIE_NAME=lang

# Shared secret for scheduled jobs (/api/workers-comp/cron). Send as: Authorization: Bearer <secret>
FORGE_CRON_SECRET=

# Help desk - server only
# Bearer secret (24+ characters) for /api/helpdesk/cron. Run it every 1-5 minutes.
HELPDESK_CRON_SECRET=
FORGE_HELPDESK_AI_MODEL=
# Optional: lets the help desk open GitHub issues for development requests.
FORGE_HELPDESK_GITHUB_TOKEN=
FORGE_HELPDESK_GITHUB_REPO=

# Email notifications - server only
RESEND_API_KEY=
FORGE_NOTIFICATIONS_EMAIL_FROM=
# Local development only: write emails to this folder instead of sending. Never set in a deployment.
FORGE_EMAIL_CAPTURE_DIR=

# Default time zone for OSHA and workers' comp dates when a tenant has none.
FORGE_DEFAULT_TIME_ZONE=America/Chicago

# Platform adapters (docs/INTEGRATION_2X_INTO_1X_PLAN.md). Leave unset for Supabase.
# Inside 1.0's AWS: FORGE_AUTH_PROVIDER=cognito signs people in through 1.0's Cognito session
# (lib/platform/cognito.ts); FORGE_STORAGE_PROVIDER switches files to S3 once that driver exists.
# Locally, `node scripts/portability/dev-platform.cjs` stands in for 1.0 and prints the values.
FORGE_AUTH_PROVIDER=
NEXT_PUBLIC_FORGE_AUTH_PROVIDER=
FORGE_COGNITO_ISSUER=
FORGE_COGNITO_CLIENT_ID=
FORGE_PLATFORM_API_URL=
FORGE_PLATFORM_ORIGIN=
FORGE_APP_ORIGIN=
FORGE_PLATFORM_LOGIN_URL=
NEXT_PUBLIC_FORGE_PLATFORM_LOGIN_URL=
NEXT_PUBLIC_FORGE_PLATFORM_LOGOUT_URL=
FORGE_STORAGE_PROVIDER=
