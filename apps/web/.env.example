BASEPATH=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_APP_DOMAIN=
# Optional stable domain for printed managed QR codes. Falls back to NEXT_PUBLIC_APP_URL.
QR_BASE_URL=

# App Configuration
NEXT_PUBLIC_APP_NAME=Forge Industrial Safety 2.0
NEXT_PUBLIC_APP_TITLE=%s | Forge Industrial Safety 2.0
NEXT_PUBLIC_APP_DESCRIPTION=Forge Industrial Safety 2.0 - industrial safety, training, compliance, inspections, fleet, emergency management, and reporting.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix this variable with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Forge AI - server only
# Never prefix the API key with NEXT_PUBLIC_.
OPENAI_API_KEY=
FORGE_AI_MODEL=gpt-6-sol
FORGE_AI_EMBEDDING_MODEL=text-embedding-3-small

# Google OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AUTH
NEXT_PUBLIC_AUTH_PASSWORD=true
NEXT_PUBLIC_AUTH_MAGIC_LINK=false

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Lemon Squeezy
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_WEBHOOK_SIGNATURE=

# Session Secret
SESSION_SECRET=

# Translations
NEXT_PUBLIC_I18N_COOKIE_NAME=lang
