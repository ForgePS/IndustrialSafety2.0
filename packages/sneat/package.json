{
  "name": "@forge/sneat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core.css": "./assets/vendor/css/core.css",
    "./demo.css": "./assets/css/demo.css",
    "./icons.css": "./assets/vendor/fonts/iconify-icons.subset.css",
    "./icons.full.css": "./assets/vendor/fonts/iconify-icons.css",
    "./page-auth.css": "./assets/vendor/css/pages/page-auth.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:icons": "node ../../scripts/build-sneat-icon-subset.mjs",
    "prebuild": "node ../../scripts/build-sneat-icon-subset.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests",
    "clean": "rimraf dist"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@forge/design-system": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
